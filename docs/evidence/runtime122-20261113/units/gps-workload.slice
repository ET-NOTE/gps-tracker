# /etc/systemd/system/gps-workload.slice
[Unit]
Description=GPS total workload budget (candidate; capacity acceptance required)
[Slice]
MemoryAccounting=yes
MemoryMax=3328M
MemorySwapMax=0
TasksMax=256


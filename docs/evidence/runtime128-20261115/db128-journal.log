2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:         
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:         CREATE FUNCTION gps_seal_cell(value jsonb, context text) RETURNS jsonb
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:         LANGUAGE plpgsql SET search_path=pg_catalog,public AS $$
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:         DECLARE ring jsonb; kid text; secret text;
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:         BEGIN
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:          IF value IS NULL OR value='null'::jsonb THEN RETURN NULL; END IF;
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:          ring:=nullif(current_setting('gps.storage_keys',true),'')::jsonb;
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:          kid:=ring->>'active'; secret:=ring->'keys'->>kid;
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:          IF secret IS NULL OR octet_length(decode(secret,'base64'))<>32 THEN
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:           RAISE EXCEPTION 'location encryption key unavailable'; END IF;
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:          RETURN jsonb_build_object('v',1,'kid',kid,'cipher',encode(public.pgp_sym_encrypt(
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:           jsonb_build_object('context',context,'kid',kid,'value',value)::text,secret,
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:           'cipher-algo=aes256,sess-key=1,s2k-mode=0,compress-algo=0,disable-mdc=0'),'base64'));
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:         END $$;
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:         
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:         CREATE FUNCTION gps_open_cell(envelope jsonb, context text) RETURNS jsonb
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:         LANGUAGE plpgsql STABLE PARALLEL RESTRICTED SET search_path=pg_catalog,public AS $$
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:         DECLARE ring jsonb; secret text; plain jsonb;
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:         BEGIN
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:          IF envelope IS NULL THEN RETURN NULL; END IF;
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:          ring:=nullif(current_setting('gps.storage_keys',true),'')::jsonb;
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:          secret:=ring->'keys'->>(envelope->>'kid');
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:          IF envelope->>'v' IS DISTINCT FROM '1' OR secret IS NULL OR octet_length(decode(secret,'base64'))<>32 THEN
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:           RAISE EXCEPTION 'location decryption key unavailable'; END IF;
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:          BEGIN
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:           plain:=public.pgp_sym_decrypt(decode(envelope->>'cipher','base64'),secret)::jsonb;
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:           IF plain->>'context' IS DISTINCT FROM context OR plain->>'kid' IS DISTINCT FROM envelope->>'kid'
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:             OR NOT plain ? 'value' THEN RAISE EXCEPTION 'invalid envelope'; END IF;
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:          EXCEPTION WHEN OTHERS THEN RAISE EXCEPTION 'location ciphertext authentication failed'; END;
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:          RETURN plain->'value';
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:         END $$;
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:         
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:         CREATE FUNCTION gps_cell_context(table_name text, row_data jsonb, identity_columns text[], field_name text)
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:         RETURNS text LANGUAGE sql IMMUTABLE AS $$
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:          SELECT jsonb_build_array('gps-location-v1',table_name,field_name,
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:            (SELECT jsonb_object_agg(k,CASE WHEN k='recorded_at' THEN to_jsonb((row_data->>k)::timestamptz AT TIME ZONE 'UTC') ELSE row_data->k END) FROM unnest(identity_columns) k))::text
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:         $$;
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:         
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:         CREATE FUNCTION gps_encrypt_location_field() RETURNS trigger LANGUAGE plpgsql
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:         SET search_path=pg_catalog,public SET timezone='UTC' AS $$
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:         DECLARE doc jsonb; field_name text:=TG_ARGV[0]; encrypted_name text:=TG_ARGV[0]||'_sealed';
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:         BEGIN
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:          IF NOT (SELECT enabled FROM public.location_storage_policy WHERE singleton) THEN RETURN NEW; END IF;
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:          doc:=to_jsonb(NEW);
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:          NEW:=jsonb_populate_record(NEW,jsonb_build_object(encrypted_name,
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:           public.gps_seal_cell(doc->field_name,public.gps_cell_context(TG_ARGV[2],doc,string_to_array(TG_ARGV[1],','),field_name)),
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:           field_name,NULL));
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:          RETURN NEW;
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:         END $$;
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:         
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:         -- Immutable primary identities bind ciphertext to a table/row/field. SIM owner
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:         -- changes are deliberately not part of the binding; historical owner is retained.
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:         CREATE TABLE location_storage_fields (
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:          table_name text PRIMARY KEY, identity_columns text[] NOT NULL, fields text[] NOT NULL
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:         );
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:         INSERT INTO location_storage_fields VALUES
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:          ('location_records',ARRAY['device_id','recorded_at','source'],ARRAY['lat','lng','raw','fixes_jsonb']),
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:          ('devices',ARRAY['id'],ARRAY['last_lat','last_lng','last_stationary']),
2026-11-15T04:41:11+0000 06a5ff7ca70c postgres[1148]:          ('events',ARRAY['id'],ARRAY['data']);

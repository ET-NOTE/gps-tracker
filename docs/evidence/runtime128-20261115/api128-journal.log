2026-11-15T04:44:16+0000 06a5ff7ca70c active-api[1443]: 2026-11-15T04:44:16.406898Z  WARN sqlx::query: slow statement: execution time exceeded alert threshold summary="SELECT DISTINCT ON(recorded_at) recorded_at, …" db.statement="\n\nSELECT DISTINCT ON(recorded_at) recorded_at, lat, lng, speed_kmh\n             FROM location_speed_metrics_between($1,(SELECT owner_id FROM gps_read_devices WHERE id=$1),$2,$3)\n            WHERE device_id = $1\n              AND user_id = (SELECT owner_id FROM gps_read_devices WHERE id = $1)\n              AND fix = TRUE\n              AND lat BETWEEN -90 AND 90 AND lng BETWEEN -180 AND 180\n              AND recorded_at >= $2 AND recorded_at < $3\n            ORDER BY recorded_at,CASE source WHEN 'phone' THEN 0 WHEN 'l80' THEN 1 ELSE 2 END\n" rows_affected=54019 rows_returned=54019 elapsed=1.350658764s elapsed_secs=1.350658764 slow_threshold=1s
2026-11-15T04:44:25+0000 06a5ff7ca70c active-api[1443]: 2026-11-15T04:44:25.057027Z  WARN http_request: sqlx::query: slow statement: execution time exceeded alert threshold summary="WITH speed AS MATERIALIZED …" db.statement="\n\nWITH speed AS MATERIALIZED (\n          SELECT device_id,user_id,fix,recorded_at,lat,lng,sat,vbat_mv,\n            speed_kmh,reported_speed_kmh,speed_interval_s,speed_reason\n          FROM location_speed_metrics_between($1,$5,$2,$3)\n         )\n         SELECT jsonb_build_object('bucket',time_bucket($4::text::interval,recorded_at),\n          'lat_avg',avg(lat),'lng_avg',avg(lng),'lat_last',last(lat,recorded_at),\n          'lng_last',last(lng,recorded_at),'recorded_at_last',max(recorded_at),\n          'sat_avg',avg(sat),'vbat_avg',avg(vbat_mv)::int,'fix_count',count(*),\n          'speed_kmh',last(speed_kmh,recorded_at),'speed_avg_kmh',avg(speed_kmh),\n          'speed_max_kmh',max(speed_kmh),'speed_sample_count',count(speed_kmh),\n          'reported_speed_kmh',last(reported_speed_kmh,recorded_at),\n          'speed_interval_s',last(speed_interval_s,recorded_at),\n          'speed_reason',last(speed_reason,recorded_at),'speed_source','server_coordinate_v1')\n         FROM speed\n         WHERE device_id=$1 AND user_id=$5 AND fix=true\n           AND recorded_at >= $2 AND recorded_at <= $3\n           AND (NOT $6 OR recorded_at < $3)\n           AND EXISTS(SELECT 1 FROM gps_read_devices WHERE id=$1 AND owner_id=$5)\n         GROUP BY time_bucket($4::text::interval,recorded_at)\n         ORDER BY time_bucket($4::text::interval,recorded_at)\n" rows_affected=363 rows_returned=363 elapsed=7.553653251s elapsed_secs=7.553653251 slow_threshold=1s method="GET"
2026-11-15T04:44:26+0000 06a5ff7ca70c active-api[1443]: 2026-11-15T04:44:26.319769Z  WARN http_request: sqlx::query: slow statement: execution time exceeded alert threshold summary="WITH scoped AS MATERIALIZED …" db.statement="\n\nWITH scoped AS MATERIALIZED (\n          SELECT recorded_at,anchor_at,source FROM location_sample_keys_between($1,$2,$3,$4)\n          WHERE ($5::text IS NULL OR source=$5) AND ($6::bool IS NULL OR fix=$6)\n            AND EXISTS(SELECT 1 FROM gps_read_devices WHERE id=$1 AND owner_id=$2)\n        ), anchors AS MATERIALIZED (\n          SELECT DISTINCT anchor_at,source FROM scoped ORDER BY anchor_at DESC,source LIMIT $7\n        ), bounds AS (\n          SELECT min(recorded_at) AS first,max(recorded_at) AS last FROM scoped JOIN anchors USING(anchor_at,source)\n        ) SELECT p.recorded_at,p.source,p.fix,p.lat,p.lng,p.sat,p.ttff_s,p.csq,p.reg,p.vbat_mv,\n          p.cbc_mv,p.device_uptime_s,p.heading,p.speed_kmh,\n          p.reported_speed_kmh,p.speed_interval_s,p.speed_reason,p.speed_source,p.anchor_at\n        FROM bounds b CROSS JOIN LATERAL location_history_points_between($1,$2,b.first,b.last) p\n        JOIN anchors a USING(anchor_at,source)\n        WHERE b.first IS NOT NULL AND ($3::timestamptz IS NULL OR p.recorded_at >= $3)\n          AND ($4::timestamptz IS NULL OR p.recorded_at <= $4)\n          AND ($6::bool IS NULL OR p.fix=$6)\n        ORDER BY p.recorded_at DESC,p.source\n" rows_affected=10000 rows_returned=10000 elapsed=1.258610966s elapsed_secs=1.258610966 slow_threshold=1s method="GET"

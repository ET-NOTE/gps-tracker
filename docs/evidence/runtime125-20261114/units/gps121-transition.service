# /etc/systemd/system/gps121-transition.service
[Unit]
BindsTo=run-gps121-sort.mount run-gps121-fallback.mount run-gps121-tmp.mount
Requires=gps121-temp-ready.service
After=gps121-temp-ready.service run-gps121-sort.mount run-gps121-fallback.mount run-gps121-tmp.mount
[Service]
Environment=LD_PRELOAD=/usr/local/lib/gps-nodump.so
Environment=PYTHONDONTWRITEBYTECODE=1
MemorySwapMax=0
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
BindPaths=/run/gps121/tmp:/tmp
BindPaths=/run/gps121/tmp:/var/tmp
Slice=gps-workload.slice
KillMode=control-group
TimeoutStartSec=900
TimeoutStopSec=25
User=root
Group=root
MemoryMax=550M
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE
BindReadOnlyPaths=/etc/gps121/credentials/transition:/run/gps121creds
Environment=CREDENTIALS_DIRECTORY=/run/gps121creds
ExecStartPre=/usr/bin/python3 /usr/local/lib/runtime118_guard.py /etc/gps121/job.json
ExecStart=/usr/bin/python3 /opt/gps121/runtime121_job.py transition
ReadWritePaths=/opt/gps121/out /opt/gps121/test-storage /opt/gps121/job-results /opt/gps121/recovery
Type=oneshot

# gps-tracker-api 환경 변수 — .env로 복사해서 사용 (.env는 git ignore)

# 바인딩 — 외부 노출 X, nginx가 reverse proxy
BIND_ADDR=127.0.0.1:3040

# PostgreSQL
DATABASE_URL=postgresql://gps_tracker_app:CHANGE_ME@127.0.0.1:5432/gps_tracker

# JWT
JWT_SECRET=CHANGE_ME_TO_LONG_RANDOM_STRING        # 32+ chars 권장
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# FCM (Firebase Cloud Messaging) — 서버 키 (Firebase 콘솔에서 발급)
FCM_SERVER_KEY=

# CORS — 개발 단계에선 *, 프로덕션에선 앱 origin / 도메인 명시
CORS_ALLOWED_ORIGINS=*

# Logging
RUST_LOG=info,gps_tracker_api=debug,tower_http=info,sqlx=warn

# gps-tracker-api 환경 변수
# .env 로 복사한 뒤 실제 값으로 채워 사용. .env 는 git ignore.
# 외부 키 발급처는 ../docs/SETUP.md 의 §1 표 참고.

# ─── 바인딩 ──────────────────────────────────────────
BIND_ADDR=127.0.0.1:3040          # 내부만 — nginx reverse proxy 뒤

# ─── PostgreSQL ──────────────────────────────────────
DATABASE_URL=postgresql://gps_tracker_app:CHANGE_ME@127.0.0.1:5432/gps_tracker

# ─── JWT ─────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_LONG_RANDOM_STRING   # 32+ char (openssl rand -hex 32)
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# ─── CORS / Logging ──────────────────────────────────
CORS_ALLOWED_ORIGINS=*                       # prod 에선 도메인 명시
RUST_LOG=info,gps_tracker_api=debug,tower_http=info,sqlx=warn

# ─── FCM (Firebase Cloud Messaging) ──────────────────
# 신규 v1 API — 서비스 계정 JSON 경로 (Firebase 콘솔 → 프로젝트 설정 → 서비스 계정)
FCM_SERVICE_ACCOUNT_PATH=
# 레거시 server-key (env 호환만 — 더 이상 사용 X)
FCM_SERVER_KEY=

# ─── 1NCE SIM (자세히는 docs/1NCE_INTEGRATION.md §8) ─
# 운영 (권장): portal.1nce.com → Configuration → API → OAuth Application
ONCE_API_CLIENT_ID=
ONCE_API_CLIENT_SECRET=
# 디버그 (1시간 만료): portal.1nce.com → Cognito 토큰
ONCE_API_TOKEN=
# 충전 결제 수단 (옵션): banktransfer | creditcard | monthlyinvoice | boleto
ONCE_REFILL_PAYMENT_METHOD=banktransfer

# ─── 카카오 ──────────────────────────────────────────
# developers.kakao.com → 내 앱 → REST API 키
KAKAO_REST_API_KEY=

# ─── Toss Payments (결제) ────────────────────────────
# docs.tosspayments.com → 개발자센터 → API 키
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_WEBHOOK_SECRET=                         # webhook HMAC 서명 검증용

# ─── OpenAI (디바이스 활동 분석) ─────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini                     # default; 모델명 override

# ─── 비즈톡 / 알림톡 / SMS ───────────────────────────
SMS_DEV_MODE=1                               # 1 = OTP 콘솔 로그만, 실제 발송 X
BIZMSG_USERID=
BIZMSG_PROFILE=
BIZMSG_SMS_SENDER=                           # 발신번호

# ─── 비즈니스 정책 토글 ──────────────────────────────
SIM_TOPUP_COST=143000                        # SIM 1회 충전 가격 (포인트)
CORPORATE_REPORT_PRICE=                      # 기업 리포트 단가 (포인트). 미설정 시 default
ALLOW_SELF_TOPUP=0                           # 1 = 사용자 본인 신용카드 결제 허용 (관리자 승인 우회)

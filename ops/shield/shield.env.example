SHIELD_ENV=production
SHIELD_ORIGIN=https://shield.serial.kr
SHIELD_BIND=127.0.0.1:3043
SHIELD_DATABASE_URL=postgres://shield_app:REPLACE_WITH_RANDOM_HEX@127.0.0.1:5432/shield_prod
RUST_LOG=shield_api=info,tower_http=warn,sqlx=warn
# Dedicated Shield configuration; never load the GPS .env from the service.
SHIELD_NCE_CLIENT_ID=
SHIELD_NCE_CLIENT_SECRET=
SHIELD_NCE_API_VERSION=v1
SHIELD_NCE_TOPUP_ENABLED=false
# Points per 500 MB request; explicitly confirm the operational price at rollout.
SHIELD_TOPUP_COST=143000

# Keep sales disabled until the customer-facing SIM product/price is confirmed.
SHIELD_SIM_SALES_ENABLED=false
# Dedicated API individual-integration keys. Never inherit GPS environment.
SHIELD_TOSS_ENABLED=false
SHIELD_TOSS_CLIENT_KEY=
SHIELD_TOSS_SECRET_KEY=
# Preview MUST use a loopback mock, never a real payment API.
# SHIELD_TOSS_BASE_URL=http://127.0.0.1:9053

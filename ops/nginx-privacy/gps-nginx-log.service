[Unit]
Description=GPS nginx error classification without request secrets
After=local-fs.target
Before=nginx.service

[Service]
Type=simple
User=syslog
Group=adm
RuntimeDirectory=gps-nginx-log
RuntimeDirectoryMode=0755
LogsDirectory=gps-nginx
LogsDirectoryMode=0750
ExecStart=/usr/sbin/rsyslogd -n -i /run/gps-nginx-log/rsyslog.pid -f /etc/gps-nginx-log.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
UMask=0027

[Install]
WantedBy=multi-user.target

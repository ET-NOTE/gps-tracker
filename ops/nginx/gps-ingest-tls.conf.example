# Merge into the existing gps.serial.kr vhost after all devices are upgraded.
# Do not replace another project's server block or enable this file wholesale.
# server: listen 443 ssl; ssl_protocols TLSv1.2 TLSv1.3;
location = /ingest {
    proxy_pass http://127.0.0.1:3041/gps-tracker/ingest;
    proxy_set_header X-GPS-TLS-Version $ssl_protocol;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_request_buffering on;
    client_max_body_size 1m;
}
location = /gps-tracker/ingest {
    proxy_pass http://127.0.0.1:3041/gps-tracker/ingest;
    proxy_set_header X-GPS-TLS-Version $ssl_protocol;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_request_buffering on;
    client_max_body_size 1m;
}
# In the HTTP (port 80) vhost explicitly reject BOTH aliases:
# location = /ingest { return 426; }
# location = /gps-tracker/ingest { return 426; }
# Never redirect telemetry POST bodies. Override X-GPS-TLS-Version on EVERY
# route that can reach the ingestion upstream; do not retain an unrestricted
# alternate proxy_pass location. Keep the upstream listener loopback-only.
# API: GPS_INGEST_TLS_REQUIRED=on, GPS_TLS_TRUSTED_PROXIES=127.0.0.1/32
# GPS_LEGACY_INGEST_ENABLED and GPS_KC_INGEST_ENABLED must both be disabled.
